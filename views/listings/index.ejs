<% layout("layouts/boilerplate") -%>

<style>
    .filters{
        align-items: center;
    }
    .filter{
        text-align:  center;
        margin-top: 1rem;
        opacity: 0.8;
        
    }
    
    .filter p{
        font-size: 0.8rem;
    }
    .filter:hover{
        opacity: 1;
        cursor: pointer;
    }
    .filter2{
        margin-left:3.2rem ;
        
    }
    .tax-info{
        display: none;
    }
    .tax-toggle{
        border: 1px solid black;
        border-radius: 0.5rem;
        height: 2.5rem;
        padding: 0.5rem;
        margin-left: 2rem;
    }


</style>

  
   <div class="filters d-flex " data-category="Beach">

    <div class="filter" data-category="Trending">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>

    <div class="filter2 filter d-none d-md-block" data-category="Rooms">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>

    <div class="filter2 filter d-none d-md-block" data-category="Amazing movies">
        <div><i class="fa-solid fa-video"></i></div>
        <p>Amazing Movies</p>
    </div>

    <div class="filter2 filter " data-category="Iconic cities">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic cities</p>
    </div>

    <div class="filter2 filter d-none d-md-block" data-category="Beach">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
    </div>

    <div class="filter2 filter d-none d-lg-block" data-category="Mountain">
        <div><i class="fa-solid fa-mountain-sun"></i></div>
        <p>Mountains</p>
    </div>

    <div class="filter2 filter d-none d-lg-block" data-category="Castles">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div>

    <div class="filter2 filter d-none d-lg-block" data-category="Amazing pooles">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </div>

    <div class="filter2 filter d-none d-lg-block" data-category="Campain">
        <div><i class="fa-solid fa-tents"></i></div>
        <p>Camping</p>
    </div>

    <div class="filter2 filter d-none d-lg-block" data-category="Farms">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farms</p>
    </div>

    <div class="filter2 filter d-none d-lg-block" data-category="Artic">
        <div><i class="fa-solid fa-person-skiing-nordic"></i></div>
        <p>Arctic</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display taxes</label>
        </div>
    </div>

</div>
<div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-1 mt-3">
    <% for(let listing of allListings){%>
        <a href="listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card" >
            <img src="<%= listing.image.url  %>"
             class="card-img-top" alt="listing_image" 
             style="height: 20rem;">
           
  
    <div class="card-img-overlay"> </div>
            <div class="card-body">
                <p class="card-text">
                    <span style="font-weight: bold;"><%= listing.title %></span>
                    <br>
                    &#8377;<%=listing.price.toLocaleString("en-IN") %>/night
                    <i class="tax-info">+18% GST</i>
                </p>
            </div>
            </div>
        </a>   
    <% } %>
</div>
<script src="/js/filter.js"></script>

