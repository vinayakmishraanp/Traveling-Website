<% layout("layouts/boilerplate") -%>



 <div class="d-flex align-items-center mt-3">

    <!-- Left Button -->
    <button class="btn btn-light shadow-sm rounded-circle d-lg-none me-2 ms-auto mb-2" id="prevBtn">
        <i class="fa-solid fa-chevron-left"></i>
    </button>

    <!-- Filters -->
    <div class="filters d-flex flex-nowrap overflow-auto" id="filters">

        <div class="filter" data-category="Trending">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>

        <div class="filter filter2" data-category="Rooms">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>

        <div class="filter filter2" data-category="Amazing movies">
            <div><i class="fa-solid fa-video"></i></div>
            <p>Amazing Movies</p>
        </div>

        <div class="filter filter2" data-category="Iconic cities">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
        </div>

        <div class="filter filter2" data-category="Beach">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beach</p>
        </div>

        <div class="filter filter2" data-category="Mountain">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>Mountains</p>
        </div>

        <div class="filter filter2" data-category="Castles">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>

        <div class="filter filter2" data-category="Amazing pooles">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>

        <div class="filter filter2" data-category="Campain">
            <div><i class="fa-solid fa-tents"></i></div>
            <p>Camping</p>
        </div>

        <div class="filter filter2" data-category="Farms">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farms</p>
        </div>

        <div class="filter filter2" data-category="Artic">
            <div><i class="fa-solid fa-person-skiing-nordic"></i></div>
            <p>Arctic</p>
        </div>

    </div>

    <!-- Right Button -->
    <button class="btn btn-light shadow-sm rounded-circle d-lg-none ms-2" id="nextBtn">
        <i class="fa-solid fa-chevron-right"></i>
    </button>

    <!-- Tax Toggle -->
    <div class="tax-toggle ms-3 mb-3">
        <div class="form-check form-switch m-0">
            <input class="form-check-input" type="checkbox" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">
                Display Taxes
            </label>
        </div>
    </div>

</div>
<div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-1 mt-3">
    <% for(let listing of allListings){%>
        <a href="listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card" >
            <img src="<%= listing.image.url  %>"
             class="card-img-top" alt="listing_image" 
             style="height: 20rem;">
           
  
    <div class="card-img-overlay"> </div>
            <div class="card-body">
                <p class="card-text">
                    <span style="font-weight: bold;"><%= listing.title %></span>
                    <br>
                    &#8377;<%=listing.price.toLocaleString("en-IN") %>/night
                    <i class="tax-info">+18% GST</i>
                </p>
            </div>
            </div>
        </a>   
    <% } %>
</div>
<script src="/js/filter.js"></script>

<script src="/js/indexOption.js"></script>